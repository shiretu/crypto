{
  "name": "1D CNN Time Series Classifier",
  "description": "Convolutional architecture for detecting local patterns in candlestick sequences",
  "layers": [
    {
      "type": "conv1d",
      "filters": 64,
      "kernelSize": 3,
      "strides": 1,
      "padding": "same",
      "activation": "relu",
      "description": "First convolutional layer - detects 3-candle patterns"
    },
    {
      "type": "maxPooling1d",
      "poolSize": 2,
      "strides": 2,
      "padding": "valid",
      "description": "Downsampling to reduce dimensionality"
    },
    {
      "type": "conv1d",
      "filters": 128,
      "kernelSize": 3,
      "strides": 1,
      "padding": "same",
      "activation": "relu",
      "description": "Second convolutional layer - detects higher-level patterns"
    },
    {
      "type": "maxPooling1d",
      "poolSize": 2,
      "strides": 2,
      "padding": "valid",
      "description": "Further downsampling"
    },
    {
      "type": "conv1d",
      "filters": 256,
      "kernelSize": 3,
      "strides": 1,
      "padding": "same",
      "activation": "relu",
      "description": "Third convolutional layer - detects complex patterns"
    },
    {
      "type": "globalAveragePooling1d",
      "description": "Aggregate features across time dimension"
    },
    {
      "type": "dense",
      "units": 128,
      "activation": "relu",
      "description": "Fully connected layer for feature combination"
    },
    {
      "type": "dropout",
      "rate": 0.4,
      "description": "Regularization to prevent overfitting"
    },
    {
      "type": "dense",
      "units": 64,
      "activation": "relu",
      "description": "Second fully connected layer"
    },
    {
      "type": "dense",
      "units": 3,
      "activation": "softmax",
      "description": "Output layer - 3 classes: [HOLD, LONG, SHORT]"
    }
  ],
  "output": {
    "shape": [
      3
    ],
    "classes": [
      "HOLD",
      "LONG",
      "SHORT"
    ],
    "description": "Probability distribution over three trading actions"
  },
  "compilation": {
    "loss": "categoricalCrossentropy",
    "optimizer": {
      "type": "adam",
      "learningRate": 0.001,
      "beta1": 0.9,
      "beta2": 0.999,
      "epsilon": 1e-07
    },
    "metrics": [
      "accuracy",
      "categoricalCrossentropy"
    ]
  },
  "training": {
    "batchSize": 64,
    "epochs": 100,
    "validationSplit": 0.2,
    "earlyStopping": {
      "monitor": "val_loss",
      "patience": 10,
      "restoreBestWeights": true
    }
  }
}