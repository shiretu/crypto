{
    "name": "Deep 1D CNN Time Series Classifier",
    "description": "Deeper convolutional architecture with more filters and layers for richer pattern detection",
    "layers": [
        {
            "type": "conv1d",
            "filters": 128,
            "kernelSize": 5,
            "strides": 1,
            "padding": "same",
            "activation": "relu",
            "description": "First conv - wide 5-candle patterns with 128 filters"
        },
        {
            "type": "conv1d",
            "filters": 128,
            "kernelSize": 5,
            "strides": 1,
            "padding": "same",
            "activation": "relu",
            "description": "Second conv - stacked 5-candle patterns"
        },
        {
            "type": "maxPooling1d",
            "poolSize": 2,
            "strides": 2,
            "padding": "valid",
            "description": "Downsample: 120 → 60"
        },
        {
            "type": "conv1d",
            "filters": 256,
            "kernelSize": 3,
            "strides": 1,
            "padding": "same",
            "activation": "relu",
            "description": "Third conv - 256 mid-level patterns"
        },
        {
            "type": "conv1d",
            "filters": 256,
            "kernelSize": 3,
            "strides": 1,
            "padding": "same",
            "activation": "relu",
            "description": "Fourth conv - stacked mid-level patterns"
        },
        {
            "type": "maxPooling1d",
            "poolSize": 2,
            "strides": 2,
            "padding": "valid",
            "description": "Downsample: 60 → 30"
        },
        {
            "type": "conv1d",
            "filters": 512,
            "kernelSize": 3,
            "strides": 1,
            "padding": "same",
            "activation": "relu",
            "description": "Fifth conv - 512 high-level patterns"
        },
        {
            "type": "conv1d",
            "filters": 512,
            "kernelSize": 3,
            "strides": 1,
            "padding": "same",
            "activation": "relu",
            "description": "Sixth conv - stacked high-level patterns"
        },
        {
            "type": "maxPooling1d",
            "poolSize": 2,
            "strides": 2,
            "padding": "valid",
            "description": "Downsample: 30 → 15"
        },
        {
            "type": "globalAveragePooling1d",
            "description": "Aggregate all features across time"
        },
        {
            "type": "dense",
            "units": 256,
            "activation": "relu",
            "description": "Large fully connected layer"
        },
        {
            "type": "dropout",
            "rate": 0.5,
            "description": "Strong regularization"
        },
        {
            "type": "dense",
            "units": 128,
            "activation": "relu",
            "description": "Second FC layer"
        },
        {
            "type": "dropout",
            "rate": 0.3,
            "description": "Moderate regularization"
        },
        {
            "type": "dense",
            "units": 64,
            "activation": "relu",
            "description": "Third FC layer"
        },
        {
            "type": "dense",
            "units": 2,
            "activation": "linear",
            "description": "Output layer - [p_buy, p_sell] linear outputs"
        }
    ],
    "output": {
        "shape": [
            2
        ],
        "values": [
            "p_buy",
            "p_sell"
        ],
        "description": "Continuous predictions for buy and sell confidence"
    },
    "compilation": {
        "loss": "meanSquaredError",
        "optimizer": {
            "type": "adam",
            "learningRate": 0.0001,
            "beta1": 0.9,
            "beta2": 0.999,
            "epsilon": 1e-07,
            "clipNorm": 1.0
        },
        "metrics": [
            "mae"
        ]
    },
    "training": {
        "batchSize": 32,
        "epochs": 1,
        "validationSplit": 0.2,
        "earlyStopping": {
            "monitor": "val_loss",
            "patience": 10,
            "restoreBestWeights": true
        }
    }
}