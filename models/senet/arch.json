{
    "name": "Squeeze-and-Excitation Network (SENet)",
    "description": "CNN with channel attention - learns which feature detectors to trust most. Won ImageNet 2017.",
    "layers": [
        {
            "type": "conv1d",
            "filters": 64,
            "kernelSize": 3,
            "strides": 1,
            "padding": "same",
            "activation": "relu",
            "description": "Conv block 1 - Initial feature extraction"
        },
        {
            "type": "squeezeExcitation",
            "reduction": 16,
            "description": "SE block 1 - Learn which of 64 features to emphasize"
        },
        {
            "type": "conv1d",
            "filters": 64,
            "kernelSize": 3,
            "strides": 1,
            "padding": "same",
            "activation": "relu",
            "description": "Conv block 1b - Refine features"
        },
        {
            "type": "squeezeExcitation",
            "reduction": 16,
            "description": "SE block 1b - Recalibrate refined features"
        },
        {
            "type": "maxPooling1d",
            "poolSize": 2,
            "strides": 2,
            "padding": "valid",
            "description": "Downsample: 120 -> 60"
        },
        {
            "type": "conv1d",
            "filters": 128,
            "kernelSize": 3,
            "strides": 1,
            "padding": "same",
            "activation": "relu",
            "description": "Conv block 2 - Mid-level patterns"
        },
        {
            "type": "squeezeExcitation",
            "reduction": 16,
            "description": "SE block 2 - Learn which of 128 features to trust"
        },
        {
            "type": "conv1d",
            "filters": 128,
            "kernelSize": 3,
            "strides": 1,
            "padding": "same",
            "activation": "relu",
            "description": "Conv block 2b - Refine mid-level patterns"
        },
        {
            "type": "squeezeExcitation",
            "reduction": 16,
            "description": "SE block 2b - Recalibrate mid-level features"
        },
        {
            "type": "maxPooling1d",
            "poolSize": 2,
            "strides": 2,
            "padding": "valid",
            "description": "Downsample: 60 -> 30"
        },
        {
            "type": "conv1d",
            "filters": 256,
            "kernelSize": 3,
            "strides": 1,
            "padding": "same",
            "activation": "relu",
            "description": "Conv block 3 - High-level patterns"
        },
        {
            "type": "squeezeExcitation",
            "reduction": 16,
            "description": "SE block 3 - Learn which of 256 features are most predictive"
        },
        {
            "type": "globalAveragePooling1d",
            "description": "Aggregate all features"
        },
        {
            "type": "dense",
            "units": 128,
            "activation": "relu",
            "description": "Decision layer 1"
        },
        {
            "type": "dropout",
            "rate": 0.4,
            "description": "Regularization"
        },
        {
            "type": "dense",
            "units": 64,
            "activation": "relu",
            "description": "Decision layer 2"
        },
        {
            "type": "dense",
            "units": 2,
            "activation": "tanh",
            "description": "Output: [p_buy, p_sell] in range [-1, 1]"
        }
    ],
    "output": {
        "transformation": "none",
        "shape": [
            2
        ],
        "values": [
            "p_buy",
            "p_sell"
        ],
        "description": "Continuous predictions for buy and sell confidence"
    },
    "compilation": {
        "loss": "meanAbsoluteError",
        "optimizer": {
            "type": "adam",
            "learningRate": 0.0008,
            "beta1": 0.9,
            "beta2": 0.999,
            "epsilon": 1e-07
        },
        "metrics": [
            "mae"
        ]
    },
    "training": {
        "batchSize": 32,
        "epochs": 1,
        "validationSplit": 0.2,
        "earlyStopping": {
            "monitor": "val_loss",
            "patience": 10,
            "restoreBestWeights": true
        }
    }
}