{
    "name": "Bidirectional LSTM with Attention",
    "description": "BiLSTM architecture that processes sequences in both directions with attention mechanism to focus on relevant timesteps",
    "layers": [
        {
            "type": "bidirectional",
            "layer": {
                "type": "lstm",
                "units": 64,
                "returnSequences": true,
                "activation": "tanh",
                "recurrentActivation": "sigmoid",
                "dropout": 0.0,
                "recurrentDropout": 0.0
            },
            "description": "Bidirectional LSTM - processes sequence forward and backward, outputting 128 features (64*2) per timestep"
        },
        {
            "type": "dropout",
            "rate": 0.3,
            "description": "Regularization after first BiLSTM"
        },
        {
            "type": "bidirectional",
            "layer": {
                "type": "lstm",
                "units": 32,
                "returnSequences": true,
                "activation": "tanh",
                "recurrentActivation": "sigmoid",
                "dropout": 0.0,
                "recurrentDropout": 0.0
            },
            "description": "Second BiLSTM - learns higher-level patterns, outputs 64 features (32*2) per timestep"
        },
        {
            "type": "dropout",
            "rate": 0.3,
            "description": "Regularization after second BiLSTM"
        },
        {
            "type": "attention",
            "description": "Attention mechanism - learns to weight important timesteps, collapses time dimension to [batch, features]"
        },
        {
            "type": "dense",
            "units": 24,
            "activation": "relu",
            "description": "Feature combination layer"
        },
        {
            "type": "dense",
            "units": 2,
            "activation": "tanh",
            "description": "Output layer - [p_buy, p_sell] in range [-1, 1]"
        }
    ],
    "output": {
        "shape": [
            2
        ],
        "values": [
            "p_buy",
            "p_sell"
        ],
        "description": "Continuous predictions for buy and sell confidence, range [-1, 1]"
    },
    "compilation": {
        "loss": "meanAbsoluteError",
        "optimizer": {
            "type": "adam",
            "learningRate": 0.0008,
            "beta1": 0.9,
            "beta2": 0.999,
            "epsilon": 1e-07
        },
        "metrics": [
            "mae"
        ]
    },
    "training": {
        "batchSize": 48,
        "epochs": 120,
        "validationSplit": 0.2,
        "earlyStopping": {
            "monitor": "val_loss",
            "patience": 10,
            "restoreBestWeights": true
        }
    }
}