{
    "name": "Gated Residual Network (GResNet)",
    "description": "Deep residual network with learned gates - dynamically adjusts computation depth per sample",
    "layers": [
        {
            "type": "conv1d",
            "filters": 64,
            "kernelSize": 3,
            "strides": 1,
            "padding": "same",
            "activation": "relu",
            "description": "Initial feature extraction"
        },
        {
            "type": "gatedResidual",
            "filters": 64,
            "kernelSize": 3,
            "activation": "relu",
            "description": "Gated residual block 1 - learns if transformation is needed"
        },
        {
            "type": "gatedResidual",
            "filters": 64,
            "kernelSize": 3,
            "activation": "relu",
            "description": "Gated residual block 2 - stacked gating for deeper selection"
        },
        {
            "type": "maxPooling1d",
            "poolSize": 2,
            "strides": 2,
            "padding": "valid",
            "description": "Downsample: 120 → 60"
        },
        {
            "type": "gatedResidual",
            "filters": 128,
            "kernelSize": 3,
            "activation": "relu",
            "description": "Gated residual block 3 - adaptive processing at 128 channels"
        },
        {
            "type": "gatedResidual",
            "filters": 128,
            "kernelSize": 3,
            "activation": "relu",
            "description": "Gated residual block 4 - deeper gated pathway"
        },
        {
            "type": "gatedResidual",
            "filters": 128,
            "kernelSize": 3,
            "activation": "relu",
            "description": "Gated residual block 5 - triple-stacked for complex decisions"
        },
        {
            "type": "maxPooling1d",
            "poolSize": 2,
            "strides": 2,
            "padding": "valid",
            "description": "Downsample: 60 → 30"
        },
        {
            "type": "gatedResidual",
            "filters": 256,
            "kernelSize": 3,
            "activation": "relu",
            "description": "Gated residual block 6 - high-level adaptive features"
        },
        {
            "type": "gatedResidual",
            "filters": 256,
            "kernelSize": 3,
            "activation": "relu",
            "description": "Gated residual block 7 - deepest gated processing"
        },
        {
            "type": "globalAveragePooling1d",
            "description": "Aggregate all features"
        },
        {
            "type": "dense",
            "units": 128,
            "activation": "relu",
            "description": "Decision layer 1"
        },
        {
            "type": "dropout",
            "rate": 0.4,
            "description": "Regularization"
        },
        {
            "type": "dense",
            "units": 64,
            "activation": "relu",
            "description": "Decision layer 2"
        },
        {
            "type": "dropout",
            "rate": 0.3,
            "description": "Light regularization"
        },
        {
            "type": "dense",
            "units": 2,
            "activation": "tanh",
            "description": "Output: [p_buy, p_sell] in range [-1, 1]"
        }
    ],
    "output": {
        "shape": [
            2
        ],
        "values": [
            "p_buy",
            "p_sell"
        ],
        "description": "Continuous predictions for buy and sell confidence"
    },
    "compilation": {
        "loss": "meanAbsoluteError",
        "optimizer": {
            "type": "adam",
            "learningRate": 0.0006,
            "beta1": 0.9,
            "beta2": 0.999,
            "epsilon": 1e-07
        },
        "metrics": [
            "mae"
        ]
    },
    "training": {
        "batchSize": 48,
        "epochs": 120,
        "validationSplit": 0.2,
        "earlyStopping": {
            "monitor": "val_loss",
            "patience": 10,
            "restoreBestWeights": true
        }
    }
}