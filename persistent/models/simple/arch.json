{
    "name": "Simple Binary Classifier with Batch Normalization",
    "description": "Binary classification for long/short signals using dense layers with batch normalization",
    "layers": [
        {
            "type": "flatten",
            "description": "Flatten [120, 15] to [1800]"
        },
        {
            "type": "dense",
            "units": 256,
            "activation": "linear",
            "kernelInitializer": "heNormal",
            "description": "Feature processing layer"
        },
        {
            "type": "batchNormalization",
            "description": "Normalize activations"
        },
        {
            "type": "activation",
            "activation": "relu",
            "description": "ReLU activation after batch norm"
        },
        {
            "type": "dropout",
            "rate": 0.4,
            "description": "Regularization"
        },
        {
            "type": "dense",
            "units": 128,
            "activation": "linear",
            "kernelInitializer": "heNormal",
            "description": "Pattern recognition layer"
        },
        {
            "type": "batchNormalization",
            "description": "Normalize activations"
        },
        {
            "type": "activation",
            "activation": "relu",
            "description": "ReLU activation after batch norm"
        },
        {
            "type": "dropout",
            "rate": 0.4,
            "description": "Regularization"
        },
        {
            "type": "dense",
            "units": 64,
            "activation": "linear",
            "kernelInitializer": "heNormal",
            "description": "Decision processing layer"
        },
        {
            "type": "batchNormalization",
            "description": "Normalize activations"
        },
        {
            "type": "activation",
            "activation": "relu",
            "description": "ReLU activation after batch norm"
        },
        {
            "type": "dropout",
            "rate": 0.3,
            "description": "Light regularization"
        },
        {
            "type": "dense",
            "units": 3,
            "activation": "softmax",
            "kernelInitializer": "glorotNormal",
            "description": "Output: [p_buy, p_sell, p_hold] classification probabilities that sum to 1"
        }
    ],
    "output": {
        "transformation": "confidenceThreeClass"
    },
    "compilation": {
        "loss": "categoricalCrossentropy",
        "optimizer": {
            "type": "adam",
            "learningRate": 0.000005,
            "beta1": 0.9,
            "beta2": 0.999,
            "epsilon": 1e-07,
            "clipNorm": 1.0
        },
        "metrics": [
            "mae",
            "mse"
        ]
    },
    "training": {
        "batchSize": 32,
        "epochs": 20,
        "filtering": "balanceBySignalStrength"
    }
}