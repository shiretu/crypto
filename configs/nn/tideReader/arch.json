{
    "layers": [
        {
            "type": "reshape",
            "inputShape": [360],
            "targetShape": [60, 6]
        },
        {
            "type": "conv1d",
            "filters": 32,
            "kernelSize": 5,
            "padding": "same",
            "activation": "relu"
        },
        {
            "type": "batchNormalization"
        },
        {
            "type": "conv1d",
            "filters": 32,
            "kernelSize": 5,
            "padding": "same",
            "activation": "relu"
        },
        {
            "type": "batchNormalization"
        },
        {
            "type": "maxPooling1d",
            "poolSize": 2
        },
        {
            "type": "conv1d",
            "filters": 64,
            "kernelSize": 5,
            "padding": "same",
            "activation": "relu"
        },
        {
            "type": "batchNormalization"
        },
        {
            "type": "conv1d",
            "filters": 64,
            "kernelSize": 5,
            "padding": "same",
            "activation": "relu"
        },
        {
            "type": "batchNormalization"
        },
        {
            "type": "globalAveragePooling1d"
        },
        {
            "type": "dropout",
            "rate": 0.3
        },
        {
            "type": "dense",
            "units": 32,
            "activation": "relu"
        },
        {
            "type": "dropout",
            "rate": 0.2
        },
        {
            "type": "dense",
            "units": 1,
            "activation": "sigmoid"
        }
    ]
}
