{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "JS train",
            "request": "launch",
            "runtimeArgs": [
                "run-script",
                "ai:train",
                "lstm"
            ],
            "runtimeExecutable": "npm",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "type": "node",
            "env": {
                "DEBUG": "express:*"
            }
        },
        {
            "name": "JS Data Generation",
            "request": "launch",
            "runtimeArgs": [
                "run-script",
                "ai:gds",
                "100000"
            ],
            "runtimeExecutable": "npm",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "type": "node",
            "env": {
                "DEBUG": "express:*"
            }
        },
        {
            "name": "JS pred",
            "request": "launch",
            "runtimeArgs": [
                "run-script",
                "ai:pred",
                "clean"
            ],
            "runtimeExecutable": "npm",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "type": "node",
            "env": {
                "DEBUG": "express:*"
            }
        },
        {
            "name": "Python train",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/python/train.py",
            "console": "integratedTerminal",
            "args": [
                "binance_ethusdc"
            ]
        }
    ]
}